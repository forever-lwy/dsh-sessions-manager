{
  "name": "@forever-lwy/dsh-sessions-manager",
  "description": "（forever-lwy fork：共享侧栏观察器、即时会话同步）DSH 会话管理：回收站、跨工作区移动、血缘、空白清理；同步上游 3.8.1 的原生菜单、冷标题缓存与工作区筛选。",
  "version": "3.8.101",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "assets"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "dsh",
    "session-manager",
    "archived-sessions",
    "session"
  ],
  "license": "MIT",
  "engines": {
    "dsh": "*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forever-lwy/dsh-sessions-manager.git"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test tests/*.test.js",
    "check:dist": "npm run build && git diff --exit-code -- lib",
    "check:sessions": "node scripts/check-session-health.mjs",
    "check:runtime": "node scripts/compat-runtime.mjs ${DSH_RUNTIME:-$HOME/.dsh/runtime}",
    "check": "node --check src/index.js && node --check src/trash-resume.js && node --check src/client/session-sync.js"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-api-session-controller": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-store": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.3",
    "@deepseek-ai/dsh-host-webserver": "0.2.2-rc.3",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.2-rc.3",
    "@deepseek-ai/dsh-session-query": "0.2.2-rc.3",
    "@deepseek-ai/dsh-storage-domain": "0.2.2-rc.3",
    "@deepseek-ai/dsh-workspace": "0.2.2-rc.3",
    "esbuild": "^0.25.0",
    "immer": "10.1.1",
    "zustand": "4.5.7",
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.2-rc.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-api-session-controller": ">=0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.2-rc.3",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.2-rc.3",
    "@deepseek-ai/dsh-session-persistence-jsonl": ">=0.2.2-rc.3",
    "@deepseek-ai/dsh-session-query": ">=0.2.2-rc.3",
    "@deepseek-ai/dsh-storage-domain": ">=0.2.2-rc.3",
    "@deepseek-ai/dsh-workspace": ">=0.2.2-rc.3",
    "react": "^18.2.0",
    "@deepseek-ai/dsh-client-ui-layout": ">=0.2.2-rc.3"
  },
  "allowScripts": {
    "esbuild@0.25.0": true
  }
}
