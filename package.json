{
  "name": "@forever-lwy/dsh-sessions-manager",
  "description": "（forever-lwy fork：侧栏观察器合并、修复会话隐藏与列表延迟）DSH 会话管理插件：设置面板 + 侧栏双入口，归档 / 恢复 / 跨工作区移动 / 回收站（可恢复、批量清空、自动清理），子代理折叠与血缘、删父会话连带子代理，空白会话识别，按标题 · ID · 工作区搜索，带磁盘占用与会话详情。已适配 DSH 0.1.7 / 0.2.0 / 0.2.1-rc.2。Session manager for DeepSeek Harness — archive / restore / move / trash lifecycle from both the settings panel and the sidebar, with subagent lineage, blank detection and per-session stats (0.1.7 / 0.2.0 / 0.2.1-rc.2 ready).",
  "version": "3.7.1003",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "assets"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "dsh",
    "session-manager",
    "archived-sessions",
    "session"
  ],
  "license": "MIT",
  "engines": {
    "dsh": "*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forever-lwy/dsh-sessions-manager.git"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test tests/*.test.js",
    "check:dist": "npm run build && git diff --exit-code -- lib",
    "check:sessions": "node scripts/check-session-health.mjs",
    "prepack": "node build.mjs",
    "check:runtime": "node scripts/compat-runtime.mjs ${DSH_RUNTIME:-$HOME/.dsh/runtime}",
    "prepare": "npm run build",
    "check": "node --check src/index.js && node --check src/trash-resume.js && node --check src/client/session-sync.js"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-api-session-controller": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-store": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.1",
    "@deepseek-ai/dsh-host-webserver": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session-query": "0.2.2-rc.1",
    "@deepseek-ai/dsh-storage-domain": "0.2.2-rc.1",
    "@deepseek-ai/dsh-workspace": "0.2.2-rc.1",
    "esbuild": "^0.25.0",
    "immer": "10.1.1",
    "zustand": "4.5.7"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-api-session-controller": ">=0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-session-persistence-jsonl": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-session-query": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-storage-domain": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-workspace": ">=0.1.0-rc.6",
    "react": "^18.2.0"
  },
  "allowScripts": {
    "esbuild@0.25.0": true
  }
}
